@page "/equipos/{id:int}"
@using Service.DTO
@inject Service.EquipoService EquipoService

<PageTitle>@(equipo?.Nombre ?? "Detalle del Equipo") - Premier League</PageTitle>

@if (equipo == null)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Cargando detalles...</span>
    </div>
}
else
{
    <div class="team-detail-container">
        @if (!string.IsNullOrEmpty(equipo.Escudo))
        {
            <div class="team-shield-container">
                <img src="@equipo.Escudo" alt="Escudo de @equipo.Nombre" class="team-shield" />
            </div>
        }
        
        <h2 class="team-name">@equipo.Nombre</h2>
        <p class="team-description">@equipo.Descripcion</p>
        
        <div class="team-info-box">
            <p><strong>Ciudad:</strong> @equipo.Ciudad</p>
            <p><strong>Fecha de Fundación:</strong> @equipo.FechaFundacion.ToString("dd/MM/yyyy")</p>
        </div>

        <NavLink href="/Equipos" class="btn-back">Volver a Equipos</NavLink>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EquipoDto? equipo;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            // Asumiendo que tienes un método para buscar por ID en tu servicio/repositorio
            equipo = await EquipoService.ObtenerPorIdAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar el equipo: {ex.Message}");
        }
    }
}

<style>
    .team-detail-container {
        max-width: 600px;
        margin: 2rem auto;
        padding: 2rem;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
        text-align: center;
    }

    .team-shield-container {
        margin-bottom: 1.5rem;
    }

    .team-shield {
        width: 120px;
        height: 120px;
        object-fit: contain;
    }

    .team-name {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 1rem;
        color: #333;
    }

    .team-description {
        font-size: 1rem;
        color: #666;
        margin-bottom: 1.5rem;
    }

    .team-info-box {
        background: #f9f9f9;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
        text-align: left;
    }

    .team-info-box p {
        margin: 0.5rem 0;
        color: #444;
    }

    .btn-back {
        display: inline-block;
        padding: 0.5rem 1rem;
        background-color: #007bff;
        color: white;
        border-radius: 4px;
        text-decoration: none;
        transition: background-color 0.2s;
    }

    .btn-back:hover {
        background-color: #0056b3;
        color: white;
    }
</style>