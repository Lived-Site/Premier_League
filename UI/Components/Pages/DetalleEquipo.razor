@page "/equipos/{id:int}"
@using Service.DTO
@inject Service.EquipoService EquipoService
@inject Service.JugadorService JugadorService

<PageTitle>@(equipo?.Nombre ?? "Detalle del Equipo") - Premier League</PageTitle>

@if (equipo == null)
{
<div class="spinner-border" role="status">
    <span class="visually-hidden">Cargando detalles...</span>
</div>
}
else
{
<div class="team-detail-container">
    @if (!string.IsNullOrEmpty(equipo.Escudo))
    {
    <div class="team-shield-container">
        <img src="@equipo.Escudo" alt="Escudo de @equipo.Nombre" class="team-shield" />
    </div>
    }

    <h2 class="team-name">@equipo.Nombre</h2>
    <p class="team-description">@equipo.Descripcion</p>

    <div class="team-info-box">
        <p><strong>Ciudad:</strong> @equipo.Ciudad</p>
        <p><strong>Fecha de Fundación:</strong> @equipo.FechaFundacion.ToString("dd/MM/yyyy")</p>
    </div>

    <NavLink href="/Equipos" class="btn-back">Volver a Equipos</NavLink>
</div>

<div class="players-container">
    <h3 class="players-title">Plantilla</h3>

    @if (jugadores == null)
    {
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Cargando jugadores...</span>
    </div>
    }
    else if (!jugadores.Any())
    {
    <p class="no-players">Este equipo no tiene jugadores cargados.</p>
    }
    else
    {
    <table class="players-table">
        <thead>
        <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Posición</th>
            <th>Nacionalidad</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var jugador in jugadores.OrderBy(j => j.Dorsal))
        {
        <tr>
            <td>@jugador.Dorsal</td>
            <td>@jugador.Nombre</td>
            <td>@jugador.Apellido</td>
            <td>@jugador.Posicion</td>
            <td>@jugador.Nacionalidad</td>
        </tr>
        }
        </tbody>
    </table>
    }
</div>
}

@code {
[Parameter]
public int Id { get; set; }

private EquipoDTO? equipo;
private IEnumerable<JugadorDTO>? jugadores;

protected override async Task OnParametersSetAsync()
{
try
{
equipo = await EquipoService.ObtenerPorIdAsync(Id);
jugadores = await JugadorService.ObtenerPorEquipoAsync(Id);
}
catch (Exception ex)
{
Console.WriteLine($"Error al cargar el equipo: {ex.Message}");
}
}
}

<style>
    .team-detail-container {
        max-width: 600px;
        margin: 2rem auto;
        padding: 2rem;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
        text-align: center;
    }

    .team-shield-container {
        margin-bottom: 1.5rem;
    }

    .team-shield {
        width: 120px;
        height: 120px;
        object-fit: contain;
    }

    .team-name {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 1rem;
        color: #333;
    }

    .team-description {
        font-size: 1rem;
        color: #666;
        margin-bottom: 1.5rem;
    }

    .team-info-box {
        background: #f9f9f9;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
        text-align: left;
    }

    .team-info-box p {
        margin: 0.5rem 0;
        color: #444;
    }

    .btn-back {
        display: inline-block;
        padding: 0.5rem 1rem;
        background-color: #007bff;
        color: white;
        border-radius: 4px;
        text-decoration: none;
        transition: background-color 0.2s;
    }

    .btn-back:hover {
        background-color: #0056b3;
        color: white;
    }

    .players-container {
        max-width: 700px;
        margin: 2rem auto;
        padding: 1.5rem 2rem;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
    }

    .players-title {
        font-size: 1.4rem;
        font-weight: bold;
        margin-bottom: 1rem;
        color: #333;
    }

    .no-players {
        color: #777;
        font-style: italic;
    }

    .players-table {
        width: 100%;
        border-collapse: collapse;
    }

    .players-table th,
    .players-table td {
        padding: 0.6rem 0.8rem;
        text-align: left;
        border-bottom: 1px solid #eee;
    }

    .players-table th {
        background-color: #f4f4f4;
        color: #333;
        font-weight: 600;
    }

    .players-table tbody tr:hover {
        background-color: #fafafa;
    }
</style>